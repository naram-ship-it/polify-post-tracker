// Prisma schema for Polify Post Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Where a post record came from. Manual entry today; X_API is reserved for
// the future automatic-pull feature so it can write into this same table
// without a schema change.
enum PostSource {
  MANUAL
  X_API
}

enum ReactionType {
  EMOJI
  TEXT
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  xHandle     String?
  // Freeform "@handle" used to address this person by name in Slack
  // messages. Not a Slack user ID — the app only has an incoming webhook,
  // not a Slack app install, so this renders as bold text (e.g. "@nimo"),
  // not a real notifying mention.
  slackHandle String?
  linkedinUrl String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Overrides AppSettings.defaultWeeklyTarget for this person. Null = use
  // the default.
  weeklyTarget Int?

  posts         Post[]
  comments      Comment[]
  questJoins    QuestJoin[]
  questPosts    QuestPost[]
  questEligible QuestParticipant[]

  @@unique([xHandle])
}

enum QuestType {
  STANDARD
  PROMO
}

// A manually-defined challenge (e.g. "post on 3 different days this week",
// or "share the new case study"). No automatic verification — completion is
// driven by members linking their own logged posts to the quest
// (QuestPost), same trust model as the rest of the app (no real login).
model Quest {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        QuestType @default(STANDARD)
  // PROMO quests point at something specific to share.
  linkUrl     String?
  ctaLabel    String?
  points      Int       @default(10)
  // How many linked posts a member needs before the quest counts as done
  // for them.
  targetPosts Int       @default(1)
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  // Empty = open to everyone (active members). Non-empty = only these
  // members can see/join it.
  participants QuestParticipant[]
  joins        QuestJoin[]
  questPosts   QuestPost[]
}

// Eligibility list for a "specific members" quest.
model QuestParticipant {
  id       String     @id @default(cuid())
  quest    Quest      @relation(fields: [questId], references: [id], onDelete: Cascade)
  questId  String
  member   TeamMember @relation(fields: [memberId], references: [id])
  memberId String

  @@unique([questId, memberId])
}

// A member committing to a quest ("Join quest"). Being eligible never
// creates this row on its own — only an explicit join does, which is what
// puts the quest on that member's Dashboard.
model QuestJoin {
  id          String     @id @default(cuid())
  quest       Quest      @relation(fields: [questId], references: [id], onDelete: Cascade)
  questId     String
  member      TeamMember @relation(fields: [memberId], references: [id])
  memberId    String
  joinedAt    DateTime   @default(now())
  // Null until the member's linked-post count reaches Quest.targetPosts.
  completedAt DateTime?

  @@unique([questId, memberId])
}

// Links one of a member's logged posts to a quest they've joined — this is
// what "counts" toward Quest.targetPosts. Chosen by the member at log time
// or attached afterwards; never auto-detected from post content.
model QuestPost {
  id        String     @id @default(cuid())
  quest     Quest      @relation(fields: [questId], references: [id], onDelete: Cascade)
  questId   String
  member    TeamMember @relation(fields: [memberId], references: [id])
  memberId  String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime   @default(now())

  @@unique([questId, postId])
}

model Post {
  id        String     @id @default(cuid())
  member    TeamMember @relation(fields: [memberId], references: [id])
  memberId  String
  url       String
  postedAt  DateTime
  note      String?
  // Post text pulled automatically from the platform (e.g. X's oEmbed) at
  // log time, distinct from `note` which is the logger's own caption.
  previewText String?
  source    PostSource @default(MANUAL)
  createdAt DateTime   @default(now())
  // Manual highlight, set by anyone from the feed. At most one post is
  // ever true at a time (enforced in the action, not the schema).
  isPostOfWeek Boolean @default(false)

  comments   Comment[]
  questPosts QuestPost[]

  @@index([postedAt])
  @@index([memberId])
}

// Single-row table for app-wide settings adjustable at runtime (no redeploy
// needed).
model AppSettings {
  id                  Int @id @default(1)
  // Weekly post target used for anyone without their own TeamMember.weeklyTarget.
  defaultWeeklyTarget Int @default(1)

  // Slack notification toggles. Quest deadline reminders has no automation
  // wired up yet (the trigger cadence is still an open decision) — the
  // toggle exists so the setting has a home once it does.
  notifyNewQuest       Boolean @default(true)
  notifyPromotion      Boolean @default(true)
  notifyWeeklyQuota    Boolean @default(true)
  notifyQuestDeadline  Boolean @default(false)
}

model Comment {
  id        String       @id @default(cuid())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  member    TeamMember   @relation(fields: [memberId], references: [id])
  memberId  String
  type      ReactionType
  emoji     String?
  text      String?
  createdAt DateTime     @default(now())

  @@index([postId])
}
